# .env.example
# 複製一份改名為 .env（本機開發），或把同樣的 key 貼進 Render 的 Environment 頁面。
# 真正的值不要 commit 進 git。

# ── Django 核心 ──
SECRET_KEY=請用下面指令產生一組隨機值，不要沿用這裡的範例
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,readytotaiwan.tw,www.readytotaiwan.tw
SITE_BASE_URL=https://readytotaiwan.tw
CSRF_TRUSTED_ORIGINS=https://readytotaiwan.tw,https://www.readytotaiwan.tw

# ── 資料庫（Supabase Postgres）──
DB_NAME=postgres
DB_USER=xxxx
DB_PASSWORD=xxxx
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432

# ── CORS（前後端分離時使用；本專案為 SSR，通常不需額外網域）──
CORS_ALLOWED_ORIGINS=https://readytotaiwan.tw

# ── Media 檔案儲存（Supabase Storage，S3-compatible；本機開發可留空，會退回本機檔案系統）──
# 到 Supabase 主控台 → Project Settings → Data API / Storage → S3 Connection 取得
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=xxxx
SUPABASE_S3_SECRET_ACCESS_KEY=xxxx
SUPABASE_S3_BUCKET_NAME=media
SUPABASE_S3_REGION=ap-southeast-1

# ── Reverse Proxy 信任設定 ──
# 部署在 Render / Nginx 等會終止 TLS 並轉發 X-Forwarded-Proto 的 proxy 後面時設 True
TRUST_X_FORWARDED_FOR=True

# ── 第三方服務 ──
OPENAI_API_KEY=xxxx
GOOGLE_MAPS_API_KEY=xxxx
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── Email（Gmail SMTP，選填；未設定則退回 console 模式）──
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=Gmail 應用程式密碼（非帳號密碼）
DEFAULT_FROM_EMAIL=noreply@readytotaiwan.tw
REQUIRE_EMAIL_VERIFICATION=False
