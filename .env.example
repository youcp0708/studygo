# 複製一份改名為 .env（本機開發），或把同樣的 key 貼進 Render 的 Environment 頁面。
# 真正的值不要 commit 進 git。

# ── Django 核心 ──
SECRET_KEY=                         # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True                          # 本機開發用 True，Render 上設 False
ALLOWED_HOSTS=localhost,127.0.0.1   # Render 上填正式網域
SITE_BASE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=               # Render 上填 https://你的網域

# ── 資料庫（Supabase Postgres）──
DB_NAME=postgres
DB_USER=                            # Supabase → Project Settings → Database → User
DB_PASSWORD=                        # Supabase → Project Settings → Database → Password
DB_HOST=                            # Supabase → Project Settings → Database → Host
DB_PORT=5432

# ── Media 檔案儲存（Supabase Storage，S3-compatible）──
# Supabase → Storage → Settings → S3 Configuration
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=media
SUPABASE_S3_REGION=ap-southeast-1

# ── Reverse Proxy ──
TRUST_X_FORWARDED_FOR=True

# ── 第三方服務 ──
OPENAI_API_KEY=                     # platform.openai.com → API keys（需要新的）
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# ── Email（Gmail SMTP，未設定則退回 console 模式）──
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=                # Gmail → 應用程式密碼
DEFAULT_FROM_EMAIL=
REQUIRE_EMAIL_VERIFICATION=False
