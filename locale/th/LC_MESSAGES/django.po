msgstr "ระบบลงทะเบียน NCU ↗"

msgid "課務日程表 ↗"
msgstr "ปฏิทินตารางเรียน ↗"

msgid "選課相關資訊 PDF ↗"
msgstr "PDF ข้อมูลการลงทะเบียน ↗"

