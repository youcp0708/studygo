msgid "搭「桃園機場捷運」至桃園高鐵站，再轉搭 172 或 173 公車直達中央大學。"
msgstr ""
"Đi MRT Sân bay đến Ga HSR Taoyuan, sau đó chuyển sang Xe buýt 172 hoặc "
"173 đi thẳng đến NCU."

msgid "🚇 機場捷運"
msgstr "🚇 MRT Sân bay"

msgid "機場捷運至高鐵桃園站約 15 分鐘，轉車後再約 15～20 分鐘"
msgstr ""
"MRT Sân bay đến Ga HSR Taoyuan khoảng 15 phút; sau đó 15–20 phút đi xe "
"buýt"

msgid "約 30～40 分鐘"
msgstr "Khoảng 30–40 phút"

msgid "從台北出發"
msgstr "Từ Đài Bắc"

msgid "國道客運 9025A 繞經中央大學，路線為松山機場－中山高－中央大學－中壢。"
msgstr ""
"Xe buýt cao tốc 9025A đi qua NCU. Tuyến: Sân bay Songshan – Cao tốc "
"Zhongshan – NCU – Zhongli."

msgid "搭至「中央大學」站下車即可，不需轉乘"
msgstr "Xuống ở bến \"Đại học Trung ương Quốc gia\"; không cần trung chuyển"

msgid "公路客運查詢 ↗"
msgstr "Tìm kiếm xe buýt cao tốc ↗"

