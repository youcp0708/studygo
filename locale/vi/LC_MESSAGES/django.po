#: .\flows\templates\flows\admissions_guide.html:252
msgid "僑生 / 外籍生 / 交換生"
msgstr "Hoa kiều / Sinh viên nước ngoài / Sinh viên trao đổi"

#: .\flows\templates\flows\admissions_guide.html:256
msgid "可申請獎學金"
msgstr "Có thể xin học bổng"

#: .\flows\templates\flows\admissions_guide.html:257
msgid "多項"
