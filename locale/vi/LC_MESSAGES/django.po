msgstr "Xuống xe và đi bộ đến cổng sau"

msgid "市區出發（後門入口）"
msgstr "Từ khu vực trung tâm (lối vào cổng sau)"

msgid "搭 5035 至「雙連坡」站下車，步行即可進入中央大學後門。"
msgstr "Đi Xe buýt 5035 đến bến \"Shuanglianpo\" và đi bộ đến cổng sau NCU."

msgid "🚪 下車後步行至後門，無需轉乘"
msgstr "🚪 Đi bộ đến cổng sau sau khi xuống xe; không cần trung chuyển"

