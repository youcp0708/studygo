msgstr "席"

msgid "大K 82 席 + 小K 31 席"
msgstr "大K 82席 + 小K 31席"

msgid "僅限中央大學在學生，刷學生證進入"
msgstr "中央大学在学生のみ；学生証タッチで入場"

msgid "先到先得，禁止佔位"
msgstr "先着順；席取り禁止"

msgid "違規 3 次 → 停用 6 個月"
msgstr "違反3回 → 6ヶ月利用停止"

msgid "公用研究室"
msgstr "共用研究室"

msgid "間"
msgstr "室"

msgid "可供師生使用"
msgstr "教員・学生が利用可能"

msgid "學期初可申請學期用室"
msgstr "学期始めに学期用室を申請可能"

msgid "臨時使用：至服務台申請"
