#: .\flows\templates\flows\admissions_guide.html:274
#: .\flows\templates\flows\admissions_guide.html:445 .\users\models.py:96
#: .\users\templates\users\edit_profile.html:89
#: .\users\templates\users\profile_setup.html:125
msgid "外籍生"
msgstr "外国人学生"

#: .\flows\templates\flows\admissions_guide.html:275
#: .\flows\templates\flows\admissions_guide.html:499
msgid "交換生"
msgstr "交換留学生"

#: .\flows\templates\flows\admissions_guide.html:283
msgid "：針對僑生設立的一年制預備課程，修畢成績合格後可直升大學學士班，無需再參加大學入學考試。適合剛完成高中學業的僑生。"
msgstr ""
": "
"華僑留学生のための1年間の準備コース。コースに合格すると、大学入学試験を受けることなく、直接学士課程に入学することができます。高校卒業直後の留学生向け。"

#: .\flows\templates\flows\admissions_guide.html:290
#: .\flows\templates\flows\admissions_guide.html:452
msgid "申請資格"
msgstr "資格"

#: .\flows\templates\flows\admissions_guide.html:291
msgid "具僑生身份、完成相當於我國高中一至三年級學業（高中畢業），成績達一定標準。年齡通常不超過 25 歲。"
msgstr ""
"申請者は華僑の資格を有し、我が国の高校1年生から3年生に相当する学業（高校卒業）を修了し、一定の学力基準に達している必要があります。通常は25歳以下です。"

#: .\flows\templates\flows\admissions_guide.html:293
#: .\flows\templates\flows\admissions_guide.html:348
msgid "高中畢業"
msgstr "高校卒業"

#: .\flows\templates\flows\admissions_guide.html:294
msgid "僑生身份"
msgstr "華僑のアイデンティティ"

#: .\flows\templates\flows\admissions_guide.html:295
msgid "25 歲以下"
msgstr "25歳未満"

#: .\flows\templates\flows\admissions_guide.html:301
msgid "申請管道"
msgstr "アプリケーションパイプライン"

#: .\flows\templates\flows\admissions_guide.html:302
msgid "透過海外聯合招生委員會（海聯會）統一分發。馬來西亞、緬甸、印尼、港澳及其他地區各有獨立招生窗口。"
msgstr ""
"海外共同入学委員会（海外共同入学委員会）を通じて一律に配布します。マレーシア、ミャンマー、インドネシア、香港、マカオ、その他の地域にはそれぞれ独立した登録窓口があります。"

#: .\flows\templates\flows\admissions_guide.html:304
msgid "海聯會"
msgstr "アラッツ"

#: .\flows\templates\flows\admissions_guide.html:305
msgid "統一分發"
msgstr "統合配信"

#: .\flows\templates\flows\admissions_guide.html:311
#: .\flows\templates\flows\admissions_guide.html:365
#: .\flows\templates\flows\admissions_guide.html:420
msgid "申請時程"
msgstr "申請スケジュール"

#: .\flows\templates\flows\admissions_guide.html:312
msgid "通常每年 1～3 月開放網路報名，各地區截止日期略有不同。錄取結果約 5～6 月公告，8 月底至 9 月初入學報到。"
msgstr ""
"オンライン登録は通常、毎年 1 月から 3 "
"月まで受け付けられますが、締め切りは地域ごとに若干異なります。合格発表は5月～6月頃、登録は8月下旬～9月上旬となります。"

#: .\flows\templates\flows\admissions_guide.html:314
msgid "1～3 月報名"
msgstr "1月から3月までの登録"

#: .\flows\templates\flows\admissions_guide.html:315
msgid "5～6 月放榜"
msgstr "5月～6月のランキングを発表"

#: .\flows\templates\flows\admissions_guide.html:316
msgid "9 月入學"
msgstr "9月入学"

#: .\flows\templates\flows\admissions_guide.html:322
#: .\flows\templates\flows\admissions_guide.html:375
#: .\flows\templates\flows\admissions_guide.html:430
msgid "獎助學金"
msgstr "奨学金と奨学金"

#: .\flows\templates\flows\admissions_guide.html:323
msgid "教育部提供僑生獎學金，另有各校及地方政府補助。成績優良僑生可申請教育部華語獎學金或特定區域補助。"
msgstr ""
"教育省は華僑学生に奨学金を提供しているほか、さまざまな学校や地方自治体から補助金も出している。優秀な学業成績を収めた留学生は、教育省の中国奨学金や特定の地域補助金に申請することができます。"

#: .\flows\templates\flows\admissions_guide.html:325
#: .\flows\templates\flows\admissions_guide.html:378
msgid "教育部獎學金"
msgstr "文部省奨学金"

#: .\flows\templates\flows\admissions_guide.html:326
msgid "學校補助"
msgstr "学校補助金"

#: .\flows\templates\flows\admissions_guide.html:337
msgid "：四年制大學課程（部分系所五年），僑生透過海聯會申請，外籍生另有各校獨立招生管道。修業成績合格者授予學士學位。"
msgstr ""
"：大学の4年制課程（一部の学部は5年制）の場合、留学生は華僑連盟を通じて申請し、留学生は学校ごとに独自の入学経路を設けています。学科試験に合格した者には学士の学位が授与されます。"

#: .\flows\templates\flows\admissions_guide.html:344
msgid "僑生申請資格"
msgstr "華僑学生の出願資格"

#: .\flows\templates\flows\admissions_guide.html:345
msgid "具僑生身份、完成高中（高級中等學校）學業成績合格，或持有同等學力證明。馬來西亞 SPM 成績、緬甸高中畢業等均可申請。"
msgstr ""
"申請者は華僑の資格を有し、高等学校（高等学校）を良好な成績で卒業した、または同等の学力証明書を所持している必要があります。マレーシアのSPM成績、ミャンマーの高校卒業などで応募可能。"

#: .\flows\templates\flows\admissions_guide.html:347
msgid "海聯會管道"
msgstr "海外提携パイプライン"

#: .\flows\templates\flows\admissions_guide.html:349
msgid "同等學力"
msgstr "同等の学力レベル"

#: .\flows\templates\flows\admissions_guide.html:355
msgid "外籍生申請資格"
msgstr "外国人留学生の応募資格"

#: .\flows\templates\flows\admissions_guide.html:356
msgid "持外國國籍、高中（或同等）學業成績達各校最低標準。部分校系要求中文或英文能力證明（HSK、TOCFL、TOEFL、IELTS 等）。"
msgstr ""
"外国籍を有し、各学校の最低基準を満たす高等学校卒業（または同等の）学業成績を有すること。一部の学校や学部では、中国語または英語能力の証明 "
"(HSK、TOCFL、TOEFL、IELTS など) が必要です。"

#: .\flows\templates\flows\admissions_guide.html:358
msgid "各校獨立招生"
msgstr "各学校が独自に生徒を募集します"

#: .\flows\templates\flows\admissions_guide.html:359
#: .\flows\templates\flows\admissions_guide.html:403
#: .\flows\templates\flows\admissions_guide.html:456
msgid "語言能力"
msgstr "語学力"

#: .\flows\templates\flows\admissions_guide.html:366
msgid "海聯會管道通常 1～3 月報名；各校獨立招生另有時程（多在 3～5 月）。建議提早確認目標校系公告。"
msgstr ""
"AIS パイプラインの登録は通常、1 月から 3 "
"月に行われます。各学校の独自入学には別の日程（主に3月から5月）があります。対象校・学科の発表を事前に確認することをおすすめします。"

#: .\flows\templates\flows\admissions_guide.html:368
msgid "1～3 月（海聯會）"
msgstr "1月～3月（海外提携）"

#: .\flows\templates\flows\admissions_guide.html:369
msgid "3～5 月（各校）"
msgstr "3月～5月（各学校）"

#: .\flows\templates\flows\admissions_guide.html:376
msgid "教育部僑生獎學金（每月約 NT$5,000～8,000）；各校可能另有入學獎學金或成績獎助。外籍生可申請教育部臺灣獎學金。"
msgstr ""
"教育省の華僑奨学金（月額約5,000～8,000台湾ドル）。各学校には入学奨学金や業績賞がある場合もあります。外国人学生は教育部台湾奨学金に応募できます。"

#: .\flows\templates\flows\admissions_guide.html:379
#: .\flows\templates\flows\admissions_guide.html:433
msgid "臺灣獎學金"
msgstr "台湾奨学金"

#: .\flows\templates\flows\admissions_guide.html:380
msgid "學校獎助"
msgstr "学校の奨学金"

#: .\flows\templates\flows\admissions_guide.html:391
msgid "：包含碩士班（2 年）與博士班（3～5 年），透過各校研究所獨立招生，部分學校設有英文授課專班。"
msgstr ""
"：各学部の研究機関を通じて独自に募集する修士課程（2年）、博士課程（3～5年）を含みます。学校によっては、英語で行われる特別授業を行っている学校もあります。"

#: .\flows\templates\flows\admissions_guide.html:398
msgid "碩士班申請資格"
msgstr "修士学位申請資格"

#: .\flows\templates\flows\admissions_guide.html:399
msgid "大學（學士）學位畢業，成績達各校系所最低標準。部分系所要求相關領域背景或語言能力證明（中文 / 英文）。"
msgstr "各学部・学科の最低基準を満たした成績で大学を卒業（学士）。一部の学部では、関連分野の背景や語学力（中国語/英語）の証明が必要です。"

#: .\flows\templates\flows\admissions_guide.html:401
msgid "學士畢業"
msgstr "学士号卒業"

#: .\flows\templates\flows\admissions_guide.html:402
msgid "相關領域"
msgstr "関連分野"

#: .\flows\templates\flows\admissions_guide.html:409
msgid "博士班申請資格"
msgstr "博士課程の出願資格"

#: .\flows\templates\flows\admissions_guide.html:410
msgid "碩士學位畢業（或同等學力），具研究潛力。通常需提交研究計畫書及相關推薦信。部分系所接受優秀碩士生直攻博士。"
msgstr ""
"研究の可能性のある修士号（または同等の学位）。通常、研究提案書と関連する推薦状が必要です。一部の学部では、優秀な修士課程の学生を受け入れて、博士号取得のために直接勉強します。"

#: .\flows\templates\flows\admissions_guide.html:412
msgid "碩士畢業"
msgstr "修士号"

#: .\flows\templates\flows\admissions_guide.html:413
msgid "研究計畫"
msgstr "研究プロジェクト"

#: .\flows\templates\flows\admissions_guide.html:414
msgid "推薦信"
msgstr "推薦状"

#: .\flows\templates\flows\admissions_guide.html:421
msgid "各校研究所招生時程不一，多在 10 月～3 月期間。建議直接查閱目標系所官網確認截止日期及備審資料需求。"
msgstr ""
"各学部の大学院の入学時期は異なりますが、主に10月から3月です。締切日や審査資料の要件については、対象学部の公式ウェブサイトで直接確認することをお勧めします。"

#: .\flows\templates\flows\admissions_guide.html:423
msgid "依各所公告"
msgstr "各事務所の発表によると"

#: .\flows\templates\flows\admissions_guide.html:424
msgid "10 月～3 月"
msgstr "10月から3月まで"

#: .\flows\templates\flows\admissions_guide.html:431
msgid "教育部臺灣獎學金（外籍研究生）；教育部僑生獎學金（僑生）；各校研究助理（RA）薪資，及科技部研究計畫補助。"
msgstr ""
"教育省の台湾奨学金（外国人大学院生）。教育省の華僑奨学金（留学生）。各学校の研究助手（RA）の給与と科学技術省からの研究プロジェクト補助金。"

#: .\flows\templates\flows\admissions_guide.html:434
msgid "研究助理薪資"
msgstr "研究助手の給与"

#: .\flows\templates\flows\admissions_guide.html:445
msgid "：持外國國籍、非以僑生身份申請的學生。透過各大學獨立招生辦理，入學後須辦理外僑居留證（ARC）。"
msgstr "：外国人留学生として申請しない外国籍の学生。各大学独自の入学手続きにより、入学後に外国人在留証明書（ARC）を申請する必要があります。"

#: .\flows\templates\flows\admissions_guide.html:455
msgid "外國國籍"
msgstr "外国籍"

#: .\flows\templates\flows\admissions_guide.html:457
msgid "前置學歷"
msgstr "前提となる学歴"

#: .\flows\templates\flows\admissions_guide.html:463
msgid "所需備審文件"
msgstr "審査に必要な書類"

#: .\flows\templates\flows\admissions_guide.html:464
msgid "護照、最高學歷成績單及畢業證書（含中英文公證）、語言能力證明、個人陳述（讀書計畫）、推薦信（研究所）、體檢報告。"
msgstr ""
"パスポート、最高学業成績証明書および卒業証明書（中国語と英語の公証を含む）、語学能力証明書、個人声明（学習計画書）、推薦状（研究機関）、身体検査成績書。"

#: .\flows\templates\flows\admissions_guide.html:466
msgid "學歷公證"
msgstr "学歴の公証"

#: .\flows\templates\flows\admissions_guide.html:467
msgid "讀書計畫"
msgstr "読書計画"

#: .\flows\templates\flows\admissions_guide.html:473
msgid "教育部臺灣獎學金"
msgstr "台湾教育省奨学金"

#: .\flows\templates\flows\admissions_guide.html:474
msgid "每月生活費 NT$15,000～25,000（依學制），免學雜費，可申請 1～4 年，名額有限，需透過台灣駐外機構或各大學推薦申請。"
msgstr ""
"月々の生活費は NT$15,000 ～ NT$25,000 です "
"(教育制度により異なります)。授業料や諸費用は免除されます。申請期間は1年から4年まで可能です。場所は限られています。申請には台湾の海外機関または大学の推薦が必要です。"

#: .\flows\templates\flows\admissions_guide.html:476
msgid "NT$15,000~/月"
msgstr "NT$15,000~/月"

#: .\flows\templates\flows\admissions_guide.html:477
msgid "免學雜費"
msgstr "授業料も手数料も無料"

#: .\flows\templates\flows\admissions_guide.html:478
msgid "名額有限"
msgstr "限られた場所"

#: .\flows\templates\flows\admissions_guide.html:484
msgid "入台後必辦事項"
msgstr "台湾に到着してからやるべきこと"

#: .\flows\templates\flows\admissions_guide.html:485
msgid "持學生居留簽入台後，須在 15 天內辦理外僑居留證（ARC），之後再辦理健保加保、開立銀行帳戶等。"
msgstr ""
"学生滞在許可証でチェックイン後、15 日以内に外国人居住証明書 (ARC) を申請し、その後、健康保険の申請、銀行口座の開設などを行う必要があります。"

#: .\flows\templates\flows\admissions_guide.html:487
msgid "15 天內辦 ARC"
msgstr "15日以内にARCを申請してください"

#: .\flows\templates\flows\admissions_guide.html:488
msgid "健保加保"
msgstr "健康保険の補足"

#: .\flows\templates\flows\admissions_guide.html:499
msgid "：由原就讀學校與台灣大學締結交換協議，短期（半年或一學年）交換就讀。學分可依協議返校抵免，通常免繳台灣學雜費。"
msgstr ""

#: .\flows\templates\flows\admissions_guide.html:507
msgid "透過原就讀學校的交流合作辦公室提名，再由台灣大學審核。無法直接向台灣大學申請，須先確認原校有締結交換協議。"
msgstr ""
"元の学校の交流協力局を通じて推薦され、国立台湾大学によって審査されます。国立台湾大学に直接応募できない場合は、まず元の学校が交換協定を締結していることを確認する必要があります。"

#: .\flows\templates\flows\admissions_guide.html:509
msgid "原校提名"
msgstr "元の学校からの推薦"

#: .\flows\templates\flows\admissions_guide.html:510
msgid "需締結協議"
msgstr "同意が必要です"

#: .\flows\templates\flows\admissions_guide.html:516
msgid "期程與截止"
msgstr "スケジュールと締め切り"

#: .\flows\templates\flows\admissions_guide.html:517
msgid "上學期（9 月）入學者通常 3～4 月截止提名；下學期（2 月）入學者通常 10～11 月截止。依各校締約條件而有不同。"
msgstr ""
"前学期（9月）に入学した志願者の推薦締め切りは通常3月から4月です。次の学期（2 月）に入学する志願者の推薦締め切りは通常 10 月から 11 "
"月です。契約条件は学校によって異なります。"

#: .\flows\templates\flows\admissions_guide.html:519
msgid "上學期：3～4 月"
msgstr "最終学期：3月～4月"

#: .\flows\templates\flows\admissions_guide.html:520
msgid "下學期：10～11 月"
msgstr "次学期：10月～11月"

#: .\flows\templates\flows\admissions_guide.html:526
msgid "簽證與居留"
msgstr "ビザと居住地"

#: .\flows\templates\flows\admissions_guide.html:527
msgid "短期（6 個月以內）可持觀光簽入台，無需辦理 ARC；6 個月以上則須以學生居留簽入台，並辦理外僑居留證。"
msgstr ""
"オンライン登録は通常、毎年 1 月から 3 "
"月まで受け付けられますが、締め切りは地域ごとに若干異なります。合格発表は5月～6月頃、登録は8月下旬～9月上旬となります。"

#: .\flows\templates\flows\admissions_guide.html:529
msgid "≤6 月：觀光簽"
msgstr "6か月以内：観光ビザ"

#: .\flows\templates\flows\admissions_guide.html:530
msgid ">6 月：需 ARC"
msgstr "6 か月以上: ARC が必要です"

#: .\flows\templates\flows\admissions_guide.html:536
msgid "費用說明"
msgstr "料金の説明"

#: .\flows\templates\flows\admissions_guide.html:537
msgid "依多數交換協議，台灣大學免收交換生學雜費。生活費（宿舍、餐飲、交通等）需自行負擔，每月約 NT$10,000～15,000。"
msgstr ""
"ほとんどの交換協定に基づき、国立台湾大学は交換留学生の授業料と手数料を免除します。生活費（寮費、食費、交通費など）は月10,000～15,000台湾ドル程度が自己負担となります。"

#: .\flows\templates\flows\admissions_guide.html:539
msgid "學雜費全免"
msgstr "授業料・手数料は無料です"

