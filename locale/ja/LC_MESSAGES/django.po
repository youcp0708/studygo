msgid "畢業或離校前：所有借書必須歸還並繳清罰款"
msgstr "卒業または離学前：すべての借用本を返却し罰金を清算すること"

msgid "自習空間"
msgstr "自習スペース"

msgid "書中心（KSC）"
msgstr "K書センター（KSC）"

msgid "中正圖書館 2F"
