msgstr "원본(심사 후 반환)."

#: .\guides\templates\guides\guide_arc_foreign.html:206
msgid "居留證正本及影本"
msgstr "거류증 원본 및 사본"

#: .\guides\templates\guides\guide_arc_foreign.html:207
msgid "現有的 ARC 卡，正本及影本各 1 份。"
msgstr "현재 ARC 카드, 원본 1부와 사본 1부."

#: .\guides\templates\guides\guide_arc_foreign.html:214
