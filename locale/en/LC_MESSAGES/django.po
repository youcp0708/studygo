msgstr "During studies (overseas/foreign students)"

msgid "僑外生經許可工作期間"
msgstr "During permitted employment (overseas/foreign students)"

msgid "投保資格"
msgstr "Eligibility"

msgid "自在臺居留滿 6 個月之日投保"
msgstr "Enroll from the date of completing 6 months of residence in Taiwan"

msgid "自受僱當日投保（無等待期）"
msgstr "Enroll from the date of employment (no waiting period)"

