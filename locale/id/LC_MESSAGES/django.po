msgid "保費：自費 NT$600（僑委會補助 NT$600，合計 NT$1,200）"
msgstr "Premi: NT$600 bayar sendiri (OCAC subsidi NT$600, total NT$1,200)"

#: .\guides\templates\guides\guide_nhi.html:37
msgid "保障期間：6 個月（一學期）"
msgstr "Periode perlindungan: 6 bulan (satu semester)"

