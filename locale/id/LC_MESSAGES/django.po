msgstr "Biaya hidup (makan/transportasi/kebutuhan sehari-hari)"

#: .\flows\templates\flows\admissions_guide.html:754
msgid "每月"
msgstr "per bulan"

#: .\flows\templates\flows\admissions_guide.html:756
msgid "約 NT$8,000 ～ 15,000"
msgstr "Sekitar NT$8.000 ~ 15.000"

#: .\flows\templates\flows\admissions_guide.html:757
msgid "視個人消費習慣而異"
msgstr "Bervariasi tergantung pada kebiasaan belanja pribadi"

#: .\flows\templates\flows\admissions_guide.html:761
msgid "全民健康保險費"
msgstr "Premi asuransi kesehatan nasional"

#: .\flows\templates\flows\admissions_guide.html:762
msgid "每月（持 ARC 加保後）"
msgstr "Bulanan (setelah menambahkan asuransi dengan ARC)"

#: .\flows\templates\flows\admissions_guide.html:764
