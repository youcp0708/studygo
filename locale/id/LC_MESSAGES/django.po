#: .\guides\templates\guides\guide_arc_exchange.html:91
#: .\guides\templates\guides\guide_arc_exchange.html:228
#: .\guides\templates\guides\guide_arc_foreign.html:56
#: .\guides\templates\guides\guide_arc_overseas.html:61
msgid "10 個工作天"
msgstr "10 hari kerja"

#: .\guides\templates\guides\guide_arc_exchange.html:92
#: .\guides\templates\guides\guide_arc_overseas.html:62
msgid "不含退補件；預約可加快"
msgstr ""
"Tidak termasuk berkas yang dikembalikan; janji temu dapat mempercepat proses"

#: .\guides\templates\guides\guide_arc_exchange.html:97
#: .\guides\templates\guides\guide_arc_foreign.html:62
#: .\guides\templates\guides\guide_arc_overseas.html:66
msgid "申請應備文件"
msgstr "Dokumen yang Diperlukan"

#: .\guides\templates\guides\guide_arc_exchange.html:103
msgid "以港澳身份入台者，需提供入出境許可證正本及影本。"
msgstr ""
"Mereka yang masuk dengan identitas HK/Makau harus menyediakan asli dan "
"salinan Izin Masuk/Keluar."

#: .\guides\templates\guides\guide_arc_exchange.html:104
msgid "持港澳證件者必備"
msgstr "Wajib bagi pemegang dokumen HK/Makau"

#: .\guides\templates\guides\guide_arc_exchange.html:110
msgid "香港 / 澳門永久居民身份證"
msgstr "KTP Penduduk Tetap Hong Kong / Makau"

#: .\guides\templates\guides\guide_arc_exchange.html:111
msgid "港澳居民身份證正本及影本，作為身份認定之用。"
msgstr "Asli dan salinan KTP Penduduk HK/Makau untuk verifikasi identitas."

