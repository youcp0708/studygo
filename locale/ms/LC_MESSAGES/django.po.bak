#: .\users\templates\users\login.html:149
msgid "登入"
msgstr "Log Masuk"

#: .\users\templates\users\login.html:94 .\users\templates\users\login.html:151
msgid "註冊帳號"
msgstr "Daftar Akaun"

#: .\users\templates\users\login.html:98
msgid "歡迎回來"
msgstr "Selamat Kembali"

#: .\users\templates\users\login.html:99
msgid "請登入您的 StudyGo 帳戶"
msgstr "Sila log masuk ke akaun StudyGo anda"

#: .\users\templates\users\login.html:112
#: .\users\templates\users\login.html:174
msgid "密碼"
msgstr "Kata Laluan"

#: .\users\templates\users\login.html:114
msgid "輸入密碼"
msgstr "Masukkan kata laluan"

#: .\users\templates\users\login.html:118
#: .\users\templates\users\login.html:180
msgid "顯示或隱藏密碼"
msgstr "Papar atau sembunyikan kata laluan"

#: .\users\templates\users\login.html:124
msgid "忘記密碼？"
msgstr "Lupa kata laluan?"

#: .\users\templates\users\login.html:135
msgid "或"
msgstr "atau"

#: .\users\templates\users\login.html:139
msgid "還沒有帳號？"
msgstr "Belum mempunyai akaun?"

#: .\users\templates\users\login.html:140
msgid "立即免費註冊"
msgstr "Daftar percuma sekarang"

#: .\users\templates\users\login.html:155
#: .\users\templates\users\profile_setup.html:15
msgid "建立帳號"
msgstr "Cipta Akaun"

#: .\users\templates\users\login.html:156
msgid "填寫基本資料，開始使用 StudyGo Taiwan"
msgstr "Isi maklumat asas untuk mula menggunakan StudyGo Taiwan"

#: .\users\templates\users\login.html:185
msgid "請輸入密碼"
msgstr "Sila masukkan kata laluan"

#: .\users\templates\users\login.html:190
msgid "確認密碼"
msgstr "Sahkan Kata Laluan"

#: .\users\templates\users\login.html:191
msgid "再次輸入密碼"
msgstr "Masukkan kata laluan sekali lagi"

#: .\users\templates\users\login.html:200
msgid "我同意"
msgstr "Saya bersetuju dengan"

#: .\users\templates\users\login.html:201
msgid "服務條款"
msgstr "Terma Perkhidmatan"

#: .\users\templates\users\login.html:202
msgid "與"
msgstr "dan"

#: .\users\templates\users\login.html:203
msgid "隱私政策"
msgstr "Dasar Privasi"

#: .\users\templates\users\login.html:210
msgid "建立帳號並繼續設定資料"
msgstr "Cipta Akaun dan Teruskan Tetapan Profil"

#: .\users\templates\users\login.html:215
msgid "已有帳號？"
msgstr "Sudah mempunyai akaun?"

#: .\users\templates\users\login.html:216
msgid "立即登入"
msgstr "Log masuk sekarang"

#: .\users\templates\users\logout_redirect.html:10
msgid "登出中…"
msgstr "Sedang log keluar..."

#: .\users\templates\users\logout_redirect.html:25
msgid "登出成功，"
msgstr "Berjaya log keluar, "

#: .\users\templates\users\logout_redirect.html:26
msgid "點此返回登入頁面"
msgstr "klik di sini untuk kembali ke halaman log masuk"

#: .\users\templates\users\profile_setup.html:4
#: .\users\templates\users\profile_setup.html:33
msgid "填寫個人資料"
msgstr "Isi Maklumat Peribadi"

#: .\users\templates\users\profile_setup.html:20
msgid "填寫資料"
msgstr "Isi Maklumat"

#: .\users\templates\users\profile_setup.html:25
msgid "開始使用"
msgstr "Mula Menggunakan"

#: .\users\templates\users\profile_setup.html:34
msgid ""
"這些資訊將用於生成您的個人化來臺流程，請確實填寫以獲得最準確的步驟提示。"
msgstr "Maklumat ini akan digunakan untuk menjana proses belajar di Taiwan yang diperibadikan untuk anda. Sila isi dengan tepat supaya anda mendapat panduan langkah yang paling sesuai."

#: .\users\templates\users\profile_setup.html:45
msgid "請選擇國籍"
msgstr "Sila pilih kewarganegaraan"

#: .\users\templates\users\profile_setup.html:72
msgid "請選擇身份別"
msgstr "Sila pilih jenis identiti"

#: .\users\templates\users\profile_setup.html:73
msgid "僑生（海外華裔）"
msgstr "Pelajar Cina Seberang Laut"

#: .\users\templates\users\profile_setup.html:77
msgid "身份別將影響您的流程任務內容"
msgstr "Jenis identiti akan mempengaruhi kandungan tugasan proses anda"

#: .\users\templates\users\profile_setup.html:88
msgid "準備來臺流程"
msgstr "Menyediakan proses kedatangan ke Taiwan"

#: .\users\templates\users\profile_setup.html:96
msgid "辦理簽證等手續"
msgstr "Mengurus visa dan prosedur berkaitan"

#: .\users\templates\users\profile_setup.html:104
msgid "辦理 ARC 等後續"
msgstr "Mengurus ARC dan prosedur susulan"

#: .\users\templates\users\profile_setup.html:112
msgid "時間規劃"
msgstr "Perancangan Masa"

#: .\users\templates\users\profile_setup.html:118
msgid "非必填"
msgstr "Pilihan"

#: .\users\templates\users\profile_setup.html:129
msgid "返回"
msgstr "Kembali"

#: .\users\templates\users\profile_setup.html:131
msgid "儲存資料並開始使用"
msgstr "Simpan Maklumat dan Mula Menggunakan"

#: .\users\templates\users\profile_setup.html:140
msgid "帳號資料預覽"
msgstr "Pratonton Maklumat Akaun"

#: .\users\templates\users\profile_setup.html:146
msgid "國籍未選"
msgstr "Kewarganegaraan belum dipilih"

#: .\users\templates\users\profile_setup.html:147
msgid "身份別未選"
msgstr "Jenis identiti belum dipilih"

#: .\users\templates\users\profile_setup.html:148
msgid "狀態未選"
msgstr "Status belum dipilih"

#: .\users\templates\users\profile_setup.html:171
msgid ""
"\n"
"            資料儲存後，系統將根據您的 <b>國籍</b>、<b>身份別</b> 與\n"
"            <b>入學狀態</b> 自動生成個人化任務流程。\n"
"            "
msgstr ""
"\n"
"            Selepas maklumat disimpan, sistem akan menjana proses tugasan peribadi secara automatik berdasarkan <b>kewarganegaraan</b>, <b>jenis identiti</b>, dan\n"
"            <b>status kemasukan</b> anda.\n"
"            "

#: .\users\templates\users\reset_password.html:4
#: .\users\templates\users\reset_password.html:11
msgid "重設密碼"
msgstr "Tetapkan Semula Kata Laluan"

#: .\users\templates\users\reset_password.html:12
msgid "請輸入您的新密碼。"
msgstr "Sila masukkan kata laluan baharu anda."

#: .\users\templates\users\reset_password.html:21
msgid "至少 8 字元"
msgstr "Sekurang-kurangnya 8 aksara"

#: .\users\templates\users\reset_password.html:35
msgid "確認重設密碼"
msgstr "Sahkan Tetapan Semula Kata Laluan"

#: .\users\templates\users\reset_password.html:55
msgid "兩次密碼不一致"
msgstr "Kedua-dua kata laluan tidak sepadan"

#: .\users\templates\users\reset_password.html:70
msgid "密碼重設成功，請重新登入"
msgstr "Kata laluan berjaya ditetapkan semula. Sila log masuk semula."

#: .\users\templates\users\reset_password.html:75
msgid "重設失敗，連結可能已過期"
msgstr "Tetapan semula gagal. Pautan mungkin telah tamat tempoh."

