#: .\chatbot\templates\chatbot\chatbot.html:3
#: .\chatbot\templates\chatbot\chatbot.html:71
#: .\users\templates\users\login.html:61
msgid "AI 聊天機器人"
msgstr "Chatbot AI"

#: .\chatbot\templates\chatbot\chatbot.html:14
msgid "回到儀表板"
msgstr "Kembali ke Papan Pemuka"

#: .\chatbot\templates\chatbot\chatbot.html:18
msgid "AI 來臺就學小幫手"
msgstr "Pembantu AI untuk Belajar di Taiwan"

#: .\chatbot\templates\chatbot\chatbot.html:19
msgid ""
"依照你的個人資料，協助整理入境前、入境後、簽證、居留證、健保與生活資訊。"
msgstr "Berdasarkan maklumat peribadi anda, sistem membantu menyusun maklumat sebelum ketibaan, selepas ketibaan, visa, ARC, insurans kesihatan dan kehidupan harian."

#: .\chatbot\templates\chatbot\chatbot.html:24
msgid "聊天記錄"
msgstr "Sejarah Sembang"

#: .\chatbot\templates\chatbot\chatbot.html:31
msgid "搜尋"
msgstr "Cari"

#: .\chatbot\templates\chatbot\chatbot.html:34
msgid "新聊天"
msgstr "Sembang Baharu"

#: .\chatbot\templates\chatbot\chatbot.html:50
msgid "聊天記錄選單"
msgstr "Menu Sejarah Sembang"

#: .\chatbot\templates\chatbot\chatbot.html:54
#: .\chatbot\templates\chatbot\chatbot.html:173
msgid "取消釘選"
msgstr "Nyahsemat"

#: .\chatbot\templates\chatbot\chatbot.html:54
#: .\chatbot\templates\chatbot\chatbot.html:172
msgid "釘選"
msgstr "Semat"

#: .\chatbot\templates\chatbot\chatbot.html:56
#: .\chatbot\templates\chatbot\chatbot.html:174
msgid "重新命名"
msgstr "Namakan Semula"

#: .\chatbot\templates\chatbot\chatbot.html:57
#: .\chatbot\templates\chatbot\chatbot.html:175
msgid "刪除"
msgstr "Padam"

#: .\chatbot\templates\chatbot\chatbot.html:62
msgid "目前沒有聊天記錄"
msgstr "Tiada sejarah sembang buat masa ini"

#: .\chatbot\templates\chatbot\chatbot.html:72
msgid "輸入你的問題，系統會根據你的身份與狀態整理建議。"
msgstr "Masukkan soalan anda. Sistem akan menyusun cadangan berdasarkan identiti dan status anda."

#: .\chatbot\templates\chatbot\chatbot.html:87
#: .\chatbot\templates\chatbot\chatbot.html:158
msgid "我"
msgstr "Saya"

#: .\chatbot\templates\chatbot\chatbot.html:89
#: .\chatbot\templates\chatbot\chatbot.html:101
#: .\chatbot\templates\chatbot\chatbot.html:159
msgid "StudyGo AI 小幫手"
msgstr "Pembantu AI StudyGo"

#: .\chatbot\templates\chatbot\chatbot.html:103
msgid "你好，"
msgstr "Helo, "

#: .\chatbot\templates\chatbot\chatbot.html:109 .\templates\base.html:70
msgid "同學"
msgstr "Pelajar"

#: .\chatbot\templates\chatbot\chatbot.html:111
msgid ""
"。你可以問我來臺就學的流程，例如簽證、居留證、健保、住宿、註冊或入境後要做什"
"麼。"
msgstr ". Anda boleh bertanya kepada saya tentang proses belajar di Taiwan, seperti visa, ARC, insurans kesihatan, penginapan, pendaftaran, atau perkara yang perlu dilakukan selepas tiba di Taiwan."

#: .\chatbot\templates\chatbot\chatbot.html:124
msgid "新增附件"
msgstr "Tambah Lampiran"

#: .\chatbot\templates\chatbot\chatbot.html:129
msgid "上傳檔案"
msgstr "Muat Naik Fail"

#: .\chatbot\templates\chatbot\chatbot.html:130
msgid "上傳圖片"
msgstr "Muat Naik Imej"

#: .\chatbot\templates\chatbot\chatbot.html:131
msgid "拍照"
msgstr "Ambil Foto"

#: .\chatbot\templates\chatbot\chatbot.html:138
msgid "例如：我從緬甸來臺讀學士班，簽證要先準備什麼？"
msgstr "Contoh: Saya datang dari Myanmar ke Taiwan untuk mengikuti program sarjana muda. Apakah yang perlu saya sediakan dahulu untuk visa?"

#: .\chatbot\templates\chatbot\chatbot.html:140
#: .\chatbot\templates\chatbot\chatbot.html:171
msgid "送出"
msgstr "Hantar"

#: .\chatbot\templates\chatbot\chatbot.html:160
msgid "已上傳附件"
msgstr "Lampiran telah dimuat naik"

#: .\chatbot\templates\chatbot\chatbot.html:161
msgid "找不到 message API"
msgstr "Message API tidak dijumpai"

#: .\chatbot\templates\chatbot\chatbot.html:162
msgid "送出失敗，請稍後再試。"
msgstr "Gagal menghantar. Sila cuba lagi kemudian."

#: .\chatbot\templates\chatbot\chatbot.html:163
msgid "網路或伺服器發生錯誤，請稍後再試。"
msgstr "Ralat rangkaian atau pelayan berlaku. Sila cuba lagi kemudian."

#: .\chatbot\templates\chatbot\chatbot.html:164
msgid "新的聊天"
msgstr "Sembang Baharu"

#: .\chatbot\templates\chatbot\chatbot.html:165
msgid "請輸入新的聊天名稱"
msgstr "Sila masukkan nama sembang baharu"

#: .\chatbot\templates\chatbot\chatbot.html:166
msgid "建立新聊天失敗"
msgstr "Gagal mencipta sembang baharu"

#: .\chatbot\templates\chatbot\chatbot.html:167
msgid "重新命名失敗"
msgstr "Gagal menamakan semula"

#: .\chatbot\templates\chatbot\chatbot.html:168
msgid "釘選失敗"
msgstr "Gagal menyemat"

#: .\chatbot\templates\chatbot\chatbot.html:169
msgid "刪除失敗"
msgstr "Gagal memadam"

#: .\chatbot\templates\chatbot\chatbot.html:170
msgid "回覆中…"
msgstr "Sedang membalas..."

