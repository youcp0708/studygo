#: .\users\templates\users\edit_profile.html:176
#: .\users\templates\users\login.html:176
msgid "至少 8 字元，含大小寫與數字"
msgstr "Sekurang-kurangnya 8 aksara, termasuk huruf besar, huruf kecil dan nombor"

#: .\users\templates\users\edit_profile.html:187
#: .\users\templates\users\reset_password.html:29
msgid "確認新密碼"
msgstr "Sahkan Kata Laluan Baharu"

#: .\users\templates\users\edit_profile.html:192
#: .\users\templates\users\reset_password.html:30
msgid "再次輸入新密碼"
msgstr "Masukkan semula kata laluan baharu"

#: .\users\templates\users\edit_profile.html:199
msgid "更新密碼"
msgstr "Kemas Kini Kata Laluan"

#: .\users\templates\users\edit_profile.html:211
msgid "電子郵件驗證"
msgstr "Pengesahan E-mel"

#: .\users\templates\users\edit_profile.html:214
msgid "已驗證"
msgstr "Telah Disahkan"

#: .\users\templates\users\edit_profile.html:216
