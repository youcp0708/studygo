msgstr "Hospital Berdekatan"

msgid "最近・急診24H"
msgstr "Paling Dekat · Kecemasan 24H"

msgid "桃園市中壢區延平路150號"
msgstr "150 Jln Yanping, Daerah Zhongli, Bandar Taoyuan"

msgid "從中大搭公車約 15–20 分鐘；設有急診室（24 小時）"
msgstr ""
"Kira-kira 15–20 minit dengan bas dari NCU; mempunyai unit kecemasan 24 jam"

msgid "壢新醫院官網 ↗"
msgstr "Laman Web Hospital Lixin ↗"

msgid "衛福部桃園醫院中壢院區"
msgstr "Hospital Taoyuan Kementerian Kesihatan — Cawangan Zhongli"

